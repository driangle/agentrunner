{
  "name": "@driangle/agentrunner",
  "version": "0.0.1",
  "description": "TypeScript library for programmatically invoking AI coding agents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./claudecode": {
      "types": "./dist/claudecode/index.d.ts",
      "import": "./dist/claudecode/index.js"
    },
    "./ollama": {
      "types": "./dist/ollama/index.d.ts",
      "import": "./dist/ollama/index.js"
    },
    "./codex": {
      "types": "./dist/codex/index.d.ts",
      "import": "./dist/codex/index.js"
    },
    "./channel": {
      "types": "./dist/channel/index.d.ts",
      "import": "./dist/channel/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/driangle/agentrunner.git",
    "directory": "ts"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "tsc --noEmit && eslint . && prettier --check .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.57.1",
    "vitest": "^3.0.0"
  },
  "optionalDependencies": {
    "@driangle/agentrunner-channel-darwin-arm64": "0.0.1",
    "@driangle/agentrunner-channel-darwin-x64": "0.0.1",
    "@driangle/agentrunner-channel-linux-arm64": "0.0.1",
    "@driangle/agentrunner-channel-linux-x64": "0.0.1",
    "@driangle/agentrunner-channel-win32-x64": "0.0.1"
  },
  "engines": {
    "node": ">=18"
  }
}
